{
  "name": "dash-player",
  "productName": "DashPlayer",
  "version": "6.17.0",
  "description": "A video player designed for English learning",
  "main": ".vite/build/main.cjs",
  "desktopName": "dashplayer.desktop",
  "scripts": {
    "download": "zx ./scripts/download.mjs",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "dev:mobile": "vite build --config vite.mobile.config.ts --watch",
    "start": "yarn run build:mobile && yarn run download && electron-forge start",
    "package": "yarn run build:mobile && yarn run download && electron-forge package",
    "make": "yarn run build:mobile && yarn run download && electron-forge make",
    "publish": "yarn run build:mobile && yarn run download && electron-forge publish",
    "lint": "eslint qa src",
    "test": "yarn run test:base",
    "test:ui": "yarn run test:base --ui",
    "test:base": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "test:run": "yarn run test:base run",
    "test:coverage": "yarn run test:base run --coverage",
    "test:watch": "yarn run test:base watch",
    "drizzle-kit": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/drizzle-kit/bin.cjs"
  },
