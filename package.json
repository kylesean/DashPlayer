{
  "name": "dash-player",
  "productName": "Refrain",
  "version": "0.1.0",
  "description": "Curated YouTube English, immersive and AI-native",
  "main": ".vite/build/main.cjs",
  "desktopName": "dashplayer.desktop",
  "scripts": {
    "download": "zx ./scripts/download.mjs",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "dev:mobile": "vite build --config vite.mobile.config.ts --watch",
    "start": "pnpm run build:mobile && pnpm run download && electron-forge start",
    "package": "pnpm run build:mobile && pnpm run download && electron-forge package",
    "make": "pnpm run build:mobile && pnpm run download && electron-forge make",
    "publish": "pnpm run build:mobile && pnpm run download && electron-forge publish",
    "lint": "eslint qa src scripts --max-warnings=0",
    "prepare": "simple-git-hooks",
    "lint:fix": "eslint qa src scripts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:base",
    "test:ui": "pnpm run test:base --ui",
    "test:base": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "test:run": "pnpm run test:base run",
    "test:coverage": "pnpm run test:base run --coverage",
    "test:watch": "pnpm run test:base watch",
    "test:e2e": "playwright test -c qa/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c qa/playwright.config.ts --grep @smoke",
    "test:e2e:packaged": "node qa/support/package-app.mjs && playwright test -c qa/playwright.packaged.config.ts",
    "qa:check-locators": "node qa/tools/check-locators.mjs",
    "qa:patch-coverage": "node scripts/check-patch-coverage.mjs",
    "drizzle-kit": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/drizzle-kit/bin.cjs"
  },
  "keywords": [],
  "author": {
    "name": "kylesean",
    "email": "jkxsai@gmail.com"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
